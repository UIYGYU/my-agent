# Copy this file to .env and fill in credentials for the services you use.
# This template contains placeholders only. Never commit your real .env.

# OpenAI-compatible LLM: local CLIProxy
LLM_API_KEY="your-cliproxy-client-api-key"
LLM_MODEL_ID="gpt-6.1-sol"
LLM_BASE_URL="http://127.0.0.1:8317/v1"

# Alternative: comment the three lines above and uncomment these for Ollama.
# LLM_API_KEY="ollama"
# LLM_MODEL_ID="gemma4:12b"
# LLM_BASE_URL="http://127.0.0.1:11434/v1"

OPENAI_API_KEY="${LLM_API_KEY}"
LLM_MODEL="${LLM_MODEL_ID}"

# Optional search and model providers
SERPAPI_API_KEY=""
MODELSCOPE_API_KEY=""
TAVILY_API_KEY=""

# Qdrant Cloud: supply your cluster URL and API key.
QDRANT_URL="https://your-cluster.your-region.cloud.qdrant.io:6333"
QDRANT_API_KEY=""
QDRANT_COLLECTION="hello_agents_vectors"
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE="cosine"
QDRANT_TIMEOUT=30

# Local Neo4j: use the credentials configured for your database.
NEO4J_URI="bolt://localhost:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="your-neo4j-password"

# Embeddings: choose a model and matching vector size for your collection.
EMBED_MODEL_TYPE="dashscope"
EMBED_MODEL_NAME="text-embedding-v3"
EMBED_API_KEY=""
EMBED_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"
